---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import SEO from "../components/seo/SEO.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Preloader from "../components/shared/Preloader.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  transparentHeader?: boolean;
  noindex?: boolean;
}

const {
  title = "Cien Mares | Experiencias Náuticas Premium en Cádiz",
  description = "Servicios náuticos de excelencia en Cádiz. Alquiler de embarcaciones, academia náutica homologada, gestoría y traslados internacionales.",
  image = "/images/og-default.jpg",
  transparentHeader = false,
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="es" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    {/* SEO Component - All meta tags and structured data */}
    <SEO 
      title={title} 
      description={description} 
      image={image}
      noindex={noindex}
      type="website"
    />

    {/* Critical Image Preload for LCP - Homepage Hero Poster */}
    {Astro.url.pathname === "/" && (
      <link rel="preload" as="image" href="https://images.unsplash.com/photo-1518837695005-2083093ee35b?w=1920&q=80" type="image/jpeg" fetchpriority="high" />
    )}
    
    {/* Google Fonts - Optimized Loading */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@200;300;400;500;600&family=JetBrains+Mono:wght@200;300;400;500&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@200;300;400;500;600&family=JetBrains+Mono:wght@200;300;400;500&display=swap" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@200;300;400;500;600&family=JetBrains+Mono:wght@200;300;400;500&display=swap" />
    </noscript>

    <ClientRouter />
  </head>

  <body class="bg-cm-bg text-cm-text font-body antialiased">
    {/* Skip to content link - Accessibility */}
    <a
      href="#main-content"
      class="skip-link"
    >
      Saltar al contenido principal
    </a>

    <Preloader />
    
    {/* Grain Overlay */}
    <div class="grain-overlay" aria-hidden="true"></div>

    {/* Custom Cursor - Desktop only */}
    <div
      id="custom-cursor"
      class="custom-cursor hidden lg:block"
      aria-hidden="true"
    >
      <div class="cursor-dot"></div>
      <div class="cursor-ring"></div>
    </div>

    <Header transparent={transparentHeader} />

    <main id="main-content" role="main" tabindex="-1">
      <slot />
    </main>

    <Footer />

    {/* Reset scroll on page load/reload */}
    <script>
      if ('scrollRestoration' in history) {
        history.scrollRestoration = 'manual';
      }
      window.scrollTo(0, 0);
      document.addEventListener("astro:after-swap", () => {
        window.scrollTo(0, 0);
      });
    </script>

    {/* Initialize scroll reveal animations - Optimized */}
    <script>
      (function initRevealAnimations() {
        function setupObserver() {
          const revealElements = document.querySelectorAll('[data-reveal]:not(.revealed)');
          if (revealElements.length === 0) return;
          
          // Use requestAnimationFrame for better performance
          requestAnimationFrame(() => {
            revealElements.forEach((el) => {
              const rect = el.getBoundingClientRect();
              if (rect.top < window.innerHeight && rect.bottom > 0) {
                el.classList.add('revealed');
              }
            });
          });
          
          const remainingElements = document.querySelectorAll('[data-reveal]:not(.revealed)');
          if (remainingElements.length === 0) return;
          
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('revealed');
                  observer.unobserve(entry.target);
                }
              });
            },
            {
              threshold: 0.05,
              rootMargin: '0px 0px 50px 0px',
            }
          );

          remainingElements.forEach((el) => observer.observe(el));
        }

        document.addEventListener('astro:page-load', setupObserver);
        
        if (document.readyState !== 'loading') {
          setupObserver();
        }
      })();
    </script>

    {/* Custom cursor - Desktop only with reduced motion support */}
    <script>
      document.addEventListener("astro:page-load", () => {
        // Check for reduced motion preference
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (prefersReducedMotion || window.innerWidth < 1024) return;

        const cursor = document.getElementById("custom-cursor");
        if (!cursor) return;

        let mouseX = 0, mouseY = 0;
        let cursorX = 0, cursorY = 0;
        let isActive = true;
        let rafId;
        let inactivityTimeout;

        function updateCursor() {
          if (!isActive) return;

          cursorX += (mouseX - cursorX) * 0.15;
          cursorY += (mouseY - cursorY) * 0.15;

          if (cursor) {
            cursor.style.transform = `translate3d(${cursorX - 20}px, ${cursorY - 20}px, 0)`;
          }

          rafId = requestAnimationFrame(updateCursor);
        }

        document.addEventListener("mousemove", (e) => {
          mouseX = e.clientX;
          mouseY = e.clientY;
          cursor.style.opacity = "1";

          clearTimeout(inactivityTimeout);
          inactivityTimeout = setTimeout(() => {
            cursor.style.opacity = "0";
          }, 3000);
        }, { passive: true });

        document.addEventListener("mouseenter", () => {
          cursor.style.opacity = "1";
          isActive = true;
          updateCursor();
        });

        document.addEventListener("mouseleave", () => {
          cursor.style.opacity = "0";
        });

        // Optimized event delegation for interactive elements
        document.addEventListener("mouseover", (e) => {
          const target = e.target.closest("a, button, [role='button'], input, textarea, select, .service-panel");
          if (target) {
            cursor.classList.add("cursor-hover");
          }
        }, { passive: true });

        document.addEventListener("mouseout", (e) => {
          const target = e.target.closest("a, button, [role='button'], input, textarea, select, .service-panel");
          if (target) {
            cursor.classList.remove("cursor-hover");
          }
        }, { passive: true });

        // Cleanup on page navigation
        document.addEventListener("astro:before-swap", () => {
          isActive = false;
          cancelAnimationFrame(rafId);
          clearTimeout(inactivityTimeout);
        });

        updateCursor();
      });
    </script>
  </body>
</html>

<style is:global>
  /* Skip to content link - Accessibility */
  .skip-link {
    position: absolute;
    top: -100%;
    left: 50%;
    transform: translateX(-50%);
    z-index: 999999;
    padding: 1rem 2rem;
    background: #CFA35A;
    color: #02060a;
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    border-radius: 0 0 1rem 1rem;
    transition: top 0.3s ease;
  }
  
  .skip-link:focus {
    top: 0;
  }

  /* Hide default cursor on desktop */
  @media (min-width: 1024px) {
    * {
      cursor: none !important;
    }
    
    /* Respect reduced motion preference */
    @media (prefers-reduced-motion: reduce) {
      * {
        cursor: auto !important;
      }
    }
  }

  /* Custom Cursor Styles */
  .custom-cursor {
    position: fixed;
    top: 0;
    left: 0;
    width: 40px;
    height: 40px;
    pointer-events: none;
    z-index: 99999;
    will-change: transform;
    opacity: 0;
    transition: opacity 0.3s ease;
    mix-blend-mode: difference;
  }

  .cursor-dot {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 8px;
    height: 8px;
    background-color: #ffffff;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    transition:
      transform 0.15s ease,
      background-color 0.15s ease;
  }

  .cursor-ring {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 32px;
    height: 32px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    transition: all 0.2s ease;
  }

  .cursor-hover .cursor-dot {
    transform: translate(-50%, -50%) scale(0);
  }

  .cursor-hover .cursor-ring {
    width: 64px;
    height: 64px;
    border-color: #ffffff;
    background-color: rgba(255, 255, 255, 1);
  }

  /* Grain Overlay */
  .grain-overlay {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 9999;
    opacity: 0.025;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 400 400' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
  }

  /* Reduced motion support */
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
    
    .custom-cursor {
      display: none !important;
    }
  }

  /* Focus visible styles for accessibility */
  *:focus-visible {
    outline: 2px solid #CFA35A;
    outline-offset: 4px;
  }

  /* Smooth scrolling */
  html {
    scroll-behavior: smooth;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
