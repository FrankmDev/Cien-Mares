---
/**
 * HeroSection — Hero de Gestión Náutica
 * Imagen a pantalla completa destacando los dos servicios: gestoría y traslados
 */
---

<section
  class="relative min-h-screen w-full overflow-hidden bg-[#02060a]"
  id="gestion-hero"
  data-theme="dark"
>
  {/* Layer 1: Background Image with Ken Burns Effect */}
  <div class="absolute inset-0 z-0">
    <img
      src="https://images.unsplash.com/photo-1569263979104-865ab7cd8d13?w=1920&q=85"
      alt="Yate en puerto"
      class="hero-bg-image w-full h-full object-cover"
      style="filter: grayscale(30%) brightness(0.4) contrast(1.1);"
    />
    {/* Multi-layer gradients for depth */}
    <div class="absolute inset-0 bg-gradient-to-b from-[#02060a]/90 via-[#02060a]/40 to-[#02060a]"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-[#02060a]/80 via-transparent to-[#02060a]/60"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_0%,rgba(2,6,10,0.5)_70%,#02060a_100%)]"></div>
  </div>

  {/* Layer 2: Animated Particles */}
  <div class="absolute inset-0 z-[1] pointer-events-none overflow-hidden" id="hero-particles">
  </div>

  {/* Layer 3: Light Rays */}
  <div class="absolute inset-0 z-[2] pointer-events-none overflow-hidden">
    <div class="light-ray absolute top-0 left-1/3 w-[1px] h-full bg-gradient-to-b from-[#CFA35A]/25 via-[#CFA35A]/5 to-transparent transform -rotate-6 origin-top"></div>
    <div class="light-ray absolute top-0 right-1/4 w-[2px] h-full bg-gradient-to-b from-[#CFA35A]/15 via-transparent to-transparent transform rotate-12 origin-top"></div>
  </div>

  {/* Layer 4: Document/Anchor Decoration */}
  <div class="absolute top-1/4 right-[8%] w-32 h-32 lg:w-48 lg:h-48 opacity-10 z-[2] pointer-events-none hero-icon">
    <svg viewBox="0 0 100 100" fill="none" class="w-full h-full">
      <path d="M50 10 L50 90 M30 30 L70 30 M30 50 L70 50 M30 70 L60 70" stroke="#CFA35A" stroke-width="2" stroke-linecap="round"/>
      <rect x="20" y="5" width="60" height="90" rx="3" stroke="#CFA35A" stroke-width="1.5"/>
      <circle cx="50" cy="20" r="8" stroke="#CFA35A" stroke-width="1"/>
      <path d="M35 85 L45 75 L55 85 L65 75" stroke="#CFA35A" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </div>

  {/* Main Content */}
  <div class="relative z-10 h-full flex flex-col justify-center min-h-screen pt-28 pb-20">
    <div class="container mx-auto px-6 lg:px-12 max-w-[1400px]">
      <div class="max-w-4xl">
        
        {/* Badge */}
        <div class="hero-badge opacity-0 translate-y-6 mb-8">
          <div class="inline-flex items-center gap-3 px-5 py-3 rounded-full bg-white/5 backdrop-blur-md border border-white/10 hover:border-[#CFA35A]/30 transition-all duration-500 group">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#CFA35A] opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-[#CFA35A]"></span>
            </span>
            <span class="font-mono text-[0.65rem] uppercase tracking-[0.3em] text-white/80 font-bold">Gestoría Náutica</span>
            <span class="hidden sm:inline-block w-[1px] h-3 bg-white/20"></span>
            <span class="hidden sm:inline-block font-mono text-[0.6rem] uppercase tracking-[0.2em] text-[#CFA35A]">Traslados</span>
          </div>
        </div>

        {/* Title with 3D effect */}
        <div class="relative mb-8">
          {/* Shadow layer */}
          <div class="hero-title-shadow absolute inset-0 flex items-center justify-start pointer-events-none opacity-0">
            <span class="font-display font-black text-[clamp(2rem,6vw,4.5rem)] leading-[0.9] tracking-tighter uppercase text-transparent whitespace-nowrap" 
                  style="-webkit-text-stroke: 1px rgba(207,163,90,0.15); transform: translateY(6px);">
              Gestión integral
            </span>
          </div>
          
          <h1 class="hero-title opacity-0 translate-y-8 relative">
            <span class="block font-display font-black text-[clamp(2rem,6vw,4.5rem)] leading-[0.9] tracking-tighter uppercase text-white drop-shadow-2xl">
              Gestión integral
            </span>
            <span class="block font-display font-black text-[clamp(2rem,6vw,4.5rem)] leading-[0.9] tracking-tighter uppercase text-transparent bg-clip-text bg-gradient-to-r from-[#CFA35A] via-[#f5e6c8] to-[#CFA35A] animate-gradient-shift">
              para tu embarcación
            </span>
          </h1>
        </div>

        {/* Subtitle */}
        <div class="hero-subtitle opacity-0 translate-y-6 mb-10">
          <p class="font-body text-lg lg:text-xl text-white/70 max-w-2xl leading-relaxed">
            Documentación, trámites, seguros, impuestos y traslados nacionales e internacionales. 
            Todo lo que tu barco necesita, con todas las garantías.
          </p>
        </div>

        {/* Service Pills */}
        <div class="hero-services opacity-0 translate-y-6 mb-10">
          <div class="flex flex-wrap gap-4">
            <div class="inline-flex items-center gap-3 px-5 py-3 rounded-full bg-[#CFA35A]/10 border border-[#CFA35A]/20 backdrop-blur-sm">
              <div class="w-8 h-8 rounded-full bg-[#CFA35A]/20 flex items-center justify-center">
                <svg class="w-4 h-4 text-[#CFA35A]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
              </div>
              <span class="font-mono text-[0.7rem] uppercase tracking-[0.1em] text-white/80">Gestoría completa</span>
            </div>
            
            <div class="inline-flex items-center gap-3 px-5 py-3 rounded-full bg-white/5 border border-white/10 backdrop-blur-sm">
              <div class="w-8 h-8 rounded-full bg-white/10 flex items-center justify-center">
                <svg class="w-4 h-4 text-white/70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <span class="font-mono text-[0.7rem] uppercase tracking-[0.1em] text-white/70">Precios transparentes</span>
            </div>
            
            <div class="inline-flex items-center gap-3 px-5 py-3 rounded-full bg-white/5 border border-white/10 backdrop-blur-sm">
              <div class="w-8 h-8 rounded-full bg-white/10 flex items-center justify-center">
                <svg class="w-4 h-4 text-white/70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <span class="font-mono text-[0.7rem] uppercase tracking-[0.1em] text-white/70">Traslados internacionales</span>
            </div>
          </div>
        </div>

        {/* Decorative line */}
        <div class="hero-line opacity-0 scale-x-0 origin-left mb-10">
          <div class="flex items-center gap-3">
            <div class="w-20 h-[2px] bg-gradient-to-r from-[#CFA35A] to-transparent"></div>
            <div class="w-2 h-2 rounded-full bg-[#CFA35A] shadow-[0_0_10px_rgba(207,163,90,0.8)]"></div>
            <div class="w-32 h-[2px] bg-[#CFA35A]/40"></div>
            <div class="w-2 h-2 rounded-full bg-[#CFA35A]/60"></div>
            <div class="w-12 h-[2px] bg-gradient-to-l from-transparent to-[#CFA35A]/30"></div>
          </div>
        </div>

        {/* CTAs */}
        <div class="hero-cta opacity-0 translate-y-6 flex flex-col sm:flex-row gap-4">
          <a
            href="#gestoria-section"
            class="group relative inline-flex items-center justify-center gap-3 px-8 py-4 bg-[#CFA35A] text-[#02060a] rounded-full font-display font-bold text-sm uppercase tracking-[0.15em] overflow-hidden transition-all duration-500 hover:shadow-[0_0_60px_rgba(207,163,90,0.5)] hover:scale-105"
          >
            <span class="relative z-10">Ver servicios</span>
            <svg class="relative z-10 w-4 h-4 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
            <div class="absolute inset-0 bg-white translate-y-full group-hover:translate-y-0 transition-transform duration-500 ease-out"></div>
          </a>

          <a
            href="https://wa.me/34605183785"
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center justify-center gap-3 px-8 py-4 border border-white/30 text-white rounded-full font-display font-bold text-sm uppercase tracking-[0.15em] hover:bg-white/10 hover:border-[#CFA35A]/50 hover:shadow-[0_0_40px_rgba(207,163,90,0.2)] transition-all duration-500 backdrop-blur-sm"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            <span>Consultar por WhatsApp</span>
          </a>
        </div>

        {/* Stats */}
        <div class="hero-stats opacity-0 translate-y-6 mt-16 lg:mt-20 flex flex-wrap gap-10 lg:gap-16">
          <div class="relative group">
            <div class="absolute -inset-4 bg-[#CFA35A]/5 rounded-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            <div class="relative text-center">
              <span class="block font-display font-black text-3xl lg:text-4xl text-[#CFA35A] group-hover:scale-110 transition-transform duration-300">500+</span>
              <span class="font-mono text-[0.6rem] uppercase tracking-[0.2em] text-white/40">Trámites gestionados</span>
            </div>
            <div class="hidden lg:block absolute -right-8 top-1/2 -translate-y-1/2 w-px h-12 bg-white/10"></div>
          </div>
          
          <div class="relative group">
            <div class="absolute -inset-4 bg-[#CFA35A]/5 rounded-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            <div class="relative text-center">
              <span class="block font-display font-black text-3xl lg:text-4xl text-[#CFA35A] group-hover:scale-110 transition-transform duration-300">15+</span>
              <span class="font-mono text-[0.6rem] uppercase tracking-[0.2em] text-white/40">Años de experiencia</span>
            </div>
            <div class="hidden lg:block absolute -right-8 top-1/2 -translate-y-1/2 w-px h-12 bg-white/10"></div>
          </div>
          
          <div class="relative group">
            <div class="absolute -inset-4 bg-[#CFA35A]/5 rounded-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            <div class="relative text-center">
              <span class="block font-display font-black text-3xl lg:text-4xl text-[#CFA35A] group-hover:scale-110 transition-transform duration-300">24h</span>
              <span class="font-mono text-[0.6rem] uppercase tracking-[0.2em] text-white/40">Respuesta garantizada</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  {/* Bottom Wave Transition */}
  <div class="absolute bottom-0 left-0 right-0 z-[5]">
    <svg class="w-full h-16 lg:h-24" viewBox="0 0 1440 120" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="pageWaveGrad" x1="0%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" stop-color="#02060a" stop-opacity="0.3"/>
          <stop offset="100%" stop-color="#02060a" stop-opacity="1"/>
        </linearGradient>
      </defs>
      <path fill="url(#pageWaveGrad)" fill-opacity="0.4" d="M0,60 C240,100 480,40 720,70 C960,100 1200,40 1440,60 L1440,120 L0,120 Z"/>
      <path fill="#02060a" fill-opacity="0.7" d="M0,80 C360,50 720,90 1080,70 C1260,60 1380,70 1440,80 L1440,120 L0,120 Z"/>
      <path fill="#02060a" d="M0,100 C480,70 960,100 1440,90 L1440,120 L0,120 Z"/>
    </svg>
  </div>

  {/* Corner Info */}
  <div class="absolute bottom-8 right-8 z-20 hidden lg:block text-right">
    <span class="font-mono text-[0.55rem] uppercase tracking-[0.3em] text-white/30 block">Cien Mares Gestión</span>
    <span class="font-mono text-[0.55rem] uppercase tracking-[0.3em] text-[#CFA35A]/50 block mt-1">Est. 2010</span>
  </div>
</section>

<style>
  /* Ken Burns animation for background */
  .hero-bg-image {
    animation: ken-burns 30s ease-in-out infinite alternate;
  }
  
  @keyframes ken-burns {
    from { transform: scale(1.05); }
    to { transform: scale(1.2); }
  }

  /* Gradient shift animation */
  .animate-gradient-shift {
    background-size: 200% 200%;
    animation: gradient-shift 8s ease infinite;
  }
  
  @keyframes gradient-shift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  /* Light ray animation */
  .light-ray {
    animation: ray-pulse 6s ease-in-out infinite;
  }
  .light-ray:nth-child(2) {
    animation-delay: -3s;
  }
  
  @keyframes ray-pulse {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 0.5; }
  }

  /* Icon float animation */
  .hero-icon {
    animation: icon-float 8s ease-in-out infinite;
  }
  
  @keyframes icon-float {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-15px) rotate(3deg); }
  }

  /* Floating particles */
  .hero-particle {
    position: absolute;
    background: rgba(207, 163, 90, 0.4);
    border-radius: 50%;
    pointer-events: none;
    animation: float-particle linear infinite;
  }
  
  @keyframes float-particle {
    0% {
      transform: translateY(100vh) translateX(0) scale(0);
      opacity: 0;
    }
    10% { opacity: 0.5; }
    90% { opacity: 0.2; }
    100% {
      transform: translateY(-20vh) translateX(20px) scale(1);
      opacity: 0;
    }
  }
</style>

<script>
  import { gsap } from "gsap";

  document.addEventListener("astro:page-load", () => {
    // Generate particles
    const container = document.getElementById('hero-particles');
    if (container) {
      for (let i = 0; i < 20; i++) {
        const particle = document.createElement('div');
        particle.className = 'hero-particle';
        const size = Math.random() * 3 + 1;
        particle.style.width = size + 'px';
        particle.style.height = size + 'px';
        particle.style.left = Math.random() * 100 + '%';
        particle.style.animationDuration = (Math.random() * 10 + 15) + 's';
        particle.style.animationDelay = Math.random() * 10 + 's';
        particle.style.opacity = (Math.random() * 0.4 + 0.1).toString();
        container.appendChild(particle);
      }
    }

    // Timeline entrance
    const tl = gsap.timeline({ delay: 0.2 });

    tl.to(".hero-badge", {
      opacity: 1,
      y: 0,
      duration: 0.7,
      ease: "power2.out"
    })
    .to(".hero-title-shadow", {
      opacity: 1,
      y: 0,
      duration: 0.8,
      ease: "power3.out"
    }, "-=0.4")
    .to(".hero-title", {
      opacity: 1,
      y: 0,
      duration: 0.9,
      ease: "power3.out"
    }, "-=0.7")
    .to(".hero-subtitle", {
      opacity: 1,
      y: 0,
      duration: 0.6,
      ease: "power2.out"
    }, "-=0.5")
    .to(".hero-services", {
      opacity: 1,
      y: 0,
      duration: 0.6,
      ease: "power2.out"
    }, "-=0.4")
    .to(".hero-line", {
      opacity: 1,
      scaleX: 1,
      duration: 0.7,
      ease: "power2.out"
    }, "-=0.4")
    .to(".hero-cta", {
      opacity: 1,
      y: 0,
      duration: 0.6,
      ease: "power2.out"
    }, "-=0.3")
    .to(".hero-stats", {
      opacity: 1,
      y: 0,
      duration: 0.6,
      ease: "power2.out"
    }, "-=0.3");
  });
</script>
