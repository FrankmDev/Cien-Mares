---
/**
 * GestoriaSection — Servicios de Gestoría Náutica
 * Grid de 2-3 columnas con cards de servicio y precios fijos
 */
import { SectionLabel, SectionTitle } from "../ui";

const SERVICES = [
  { name: "Inscripción de embarcación", price: "130€", popular: true },
  { name: "Certificado de navegabilidad", price: "120€", popular: false },
  { name: "Licencia de estación de barco", price: "90€", popular: false },
  { name: "Gestión de impuestos (por modelo)", price: "50€", popular: false },
  { name: "Cambio de titularidad o denominación", price: "75€", popular: false },
  { name: "Renovación de permiso de navegación", price: "55€", popular: false },
  { name: "Cambio de lista", price: "90€", popular: false },
  { name: "Baja de registro", price: "90€", popular: false },
  { name: "Abanderamiento en Polonia", price: "400€", popular: true },
  { name: "Cambio de titularidad en Polonia", price: "350€", popular: false },
  { name: "Otros trámites", price: "Consultar", popular: false },
] as const;
---

<section class="relative bg-[#02060a] py-28 lg:py-36 overflow-hidden" id="gestoria-section" data-theme="dark">
  {/* Background Effects */}
  <div class="absolute inset-0 z-0">
    <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-[#CFA35A]/30 to-transparent"></div>
    <div class="absolute bottom-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-[#CFA35A]/30 to-transparent"></div>
    <div class="absolute top-1/4 right-0 w-[600px] h-[600px] bg-[#CFA35A]/[0.02] rounded-full blur-[150px]"></div>
    <div class="absolute bottom-1/4 left-0 w-[400px] h-[400px] bg-[#CFA35A]/[0.015] rounded-full blur-[120px]"></div>
  </div>

  <div class="container mx-auto px-6 lg:px-12 relative z-10 max-w-[1400px]">
    {/* Header */}
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-8 mb-16 lg:mb-20">
      <div class="lg:w-[55%]">
        <div class="mb-6">
          <SectionLabel label="Servicios de Gestoría" variant="light" />
        </div>
        <SectionTitle firstLine="Trámites y" secondLine="documentación" />
      </div>
      <div class="lg:w-[40%]">
        <p class="font-body text-base lg:text-lg text-white/60 leading-relaxed">
          Precios transparentes y cerrados. Nos encargamos de todo el papeleo ante las autoridades marítimas para que tú solo tengas que firmar.
        </p>
      </div>
    </div>

    {/* Services Grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 lg:gap-6">
      {SERVICES.map((service, i) => (
        <div 
          class="service-card group relative"
          data-reveal="fade"
          data-delay={(i % 3) + 1}
        >
          <div class={`
            relative h-full p-6 lg:p-8 rounded-2xl border transition-all duration-500
            ${service.popular 
              ? 'bg-[#CFA35A]/10 border-[#CFA35A]/30 hover:border-[#CFA35A]/60' 
              : 'bg-white/[0.02] border-white/10 hover:border-[#CFA35A]/30 hover:bg-white/[0.04]'
            }
          `}>
            {/* Popular Badge */}
            {service.popular && (
              <div class="absolute -top-3 left-6">
                <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-[#CFA35A] text-[#02060a] font-mono text-[0.6rem] uppercase tracking-wider font-bold">
                  <svg class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                  </svg>
                  Popular
                </span>
              </div>
            )}

            {/* Content */}
            <div class="flex flex-col h-full">
              {/* Number */}
              <span class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-white/30 mb-4">
                Servicio {String(i + 1).padStart(2, '0')}
              </span>

              {/* Name */}
              <h3 class={`font-display font-bold text-lg lg:text-xl mb-4 transition-colors ${service.popular ? 'text-[#CFA35A]' : 'text-white group-hover:text-[#CFA35A]'}`}>
                {service.name}
              </h3>

              {/* Price - Prominent */}
              <div class="mt-auto pt-4 border-t border-white/10">
                <div class="flex items-baseline gap-2">
                  <span class={`font-display font-black text-3xl lg:text-4xl ${service.popular ? 'text-[#CFA35A]' : 'text-white group-hover:text-[#CFA35A]'} transition-colors`}>
                    {service.price}
                  </span>
                  {service.price !== 'Consultar' && (
                    <span class="font-mono text-[0.6rem] uppercase tracking-[0.15em] text-white/40">IVA incluido</span>
                  )}
                </div>
              </div>
            </div>

            {/* Hover Effect */}
            <div class={`absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none ${service.popular ? 'bg-[#CFA35A]/5' : 'bg-gradient-to-br from-[#CFA35A]/5 to-transparent'}`}></div>
          </div>
        </div>
      ))}
    </div>

    {/* Bottom Note */}
    <div class="mt-12 lg:mt-16 flex flex-col lg:flex-row items-center justify-center gap-6">
      <div class="flex items-center gap-3 px-6 py-4 rounded-2xl bg-white/[0.02] border border-white/10">
        <div class="w-10 h-10 rounded-full bg-[#CFA35A]/10 flex items-center justify-center">
          <svg class="w-5 h-5 text-[#CFA35A]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <span class="font-mono text-[0.7rem] uppercase tracking-[0.1em] text-white/60">Precios cerrados, sin sorpresas</span>
      </div>
      
      <div class="flex items-center gap-3 px-6 py-4 rounded-2xl bg-white/[0.02] border border-white/10">
        <div class="w-10 h-10 rounded-full bg-[#CFA35A]/10 flex items-center justify-center">
          <svg class="w-5 h-5 text-[#CFA35A]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <span class="font-mono text-[0.7rem] uppercase tracking-[0.1em] text-white/60">Plazos rápidos garantizados</span>
      </div>
      
      <div class="flex items-center gap-3 px-6 py-4 rounded-2xl bg-white/[0.02] border border-white/10">
        <div class="w-10 h-10 rounded-full bg-[#CFA35A]/10 flex items-center justify-center">
          <svg class="w-5 h-5 text-[#CFA35A]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
        </div>
        <span class="font-mono text-[0.7rem] uppercase tracking-[0.1em] text-white/60">Informe de seguimiento por email</span>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("astro:page-load", () => {
    // Cards entrance animation
    gsap.fromTo(".service-card", 
      { y: 50, opacity: 0 },
      {
        y: 0,
        opacity: 1,
        duration: 0.6,
        stagger: 0.08,
        ease: "power3.out",
        scrollTrigger: {
          trigger: "#gestoria-section",
          start: "top 70%",
        },
      }
    );
  });
</script>
