---
/**
 * HowClassesWorkSection — Cómo son las clases
 * Layout de 2 columnas: teoría y práctica
 */
import { SectionLabel, SectionTitle } from "../ui";

const THEORY_ITEMS = [
  {
    title: "Preparación para el examen oficial",
    description: "Temario completo adaptado a cada titulación con enfoque en los contenidos que realmente salen en el examen.",
    icon: "M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z",
  },
  {
    title: "Temario oficial DGMM",
    description: "Navegación, seguridad, normativa, meteorología y teoría de máquinas siguiendo el programa oficial.",
    icon: "M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253",
  },
  {
    title: "Test de práctica",
    description: "Simulacros de examen con miles de preguntas reales de convocatorias anteriores para llegar con total confianza.",
    icon: "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4",
  },
];

const PRACTICE_ITEMS = [
  {
    title: "Maniobras reales con embarcación",
    description: "Aprende gobierno, viradas, cambios de rumbo y control de la embarcación en condiciones reales de navegación.",
    icon: "M13 10V3L4 14h7v7l9-11h-7z",
  },
  {
    title: "Navegación costera",
    description: "Prácticas de carta náutica, puntos de posición, rumbos y navegación estimada en la bahía de Cádiz.",
    icon: "M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0121 18.382V7.618a1 1 0 01-.806-.984A3 3 0 0018 10a3 3 0 00-5.68-1.33",
  },
  {
    title: "Atraque y fondeo",
    description: "Técnicas de aproximación a puerto, maniobras de atraque con viento y corriente, y fondeo seguro.",
    icon: "M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1",
  },
  {
    title: "Meteorología aplicada",
    description: "Lectura del tiempo en el mar, interpretación de nubes, viento y oleaje para navegar con seguridad.",
    icon: "M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z",
  },
];
---

<section class="relative bg-[#02060a] py-28 lg:py-36 overflow-hidden" id="how-classes" data-theme="dark">
  {/* Background Effects */}
  <div class="absolute inset-0 z-0">
    <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-[#CFA35A]/30 to-transparent"></div>
    <div class="absolute bottom-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-[#CFA35A]/30 to-transparent"></div>
    <div class="absolute top-1/2 left-1/4 w-[500px] h-[500px] bg-[#CFA35A]/[0.02] rounded-full blur-[150px] -translate-y-1/2"></div>
    <div class="absolute top-1/3 right-0 w-[400px] h-[400px] bg-[#CFA35A]/[0.015] rounded-full blur-[120px]"></div>
  </div>

  <div class="container mx-auto px-6 lg:px-12 relative z-10 max-w-[1400px]">
    {/* Header */}
    <div class="text-center max-w-3xl mx-auto mb-16 lg:mb-20">
      <div class="mb-6 flex justify-center">
        <SectionLabel label="Metodología" variant="light" />
      </div>
      <SectionTitle firstLine="Cómo son las" secondLine="clases" />
      <p class="font-body text-base lg:text-lg text-white/60 leading-relaxed mt-6">
        Una combinación perfecta de teoría sólida y práctica intensiva en el mar. 
        Aprende de verdad con instructores que llevan décadas navegando.
      </p>
    </div>

    {/* Two Columns */}
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">
      {/* Theory Column */}
      <div class="how-classes-col group" data-reveal="fade" data-delay="1">
        <div class="relative h-full p-8 lg:p-10 rounded-3xl bg-white/[0.02] border border-white/10 hover:border-[#CFA35A]/30 transition-all duration-500">
          {/* Header */}
          <div class="flex items-start gap-6 mb-10">
            <div class="w-16 h-16 rounded-2xl bg-[#CFA35A]/10 border border-[#CFA35A]/20 flex items-center justify-center shrink-0 group-hover:bg-[#CFA35A] group-hover:border-[#CFA35A] transition-all duration-500">
              <svg class="w-8 h-8 text-[#CFA35A] group-hover:text-[#02060a] transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
              </svg>
            </div>
            <div>
              <span class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-[#CFA35A] block mb-2">En aula</span>
              <h3 class="font-display font-black text-2xl lg:text-3xl uppercase tracking-tight text-white">
                Clases teóricas
              </h3>
            </div>
          </div>

          {/* Items */}
          <div class="space-y-6">
            {THEORY_ITEMS.map((item) => (
              <div class="flex gap-5 p-5 rounded-2xl bg-white/[0.03] border border-white/5 hover:border-[#CFA35A]/20 hover:bg-white/[0.05] transition-all duration-300 group/item">
                <div class="w-10 h-10 rounded-full bg-[#CFA35A]/10 flex items-center justify-center shrink-0 group-hover/item:bg-[#CFA35A]/20 transition-colors">
                  <svg class="w-5 h-5 text-[#CFA35A]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d={item.icon}/>
                  </svg>
                </div>
                <div>
                  <h4 class="font-display font-bold text-white mb-1 group-hover/item:text-[#CFA35A] transition-colors">
                    {item.title}
                  </h4>
                  <p class="text-sm text-white/50 leading-relaxed">
                    {item.description}
                  </p>
                </div>
              </div>
            ))}
          </div>

          {/* Bottom Note */}
          <div class="mt-8 pt-6 border-t border-white/10">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-full bg-[#CFA35A]/10 flex items-center justify-center">
                <svg class="w-4 h-4 text-[#CFA35A]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <span class="font-mono text-[0.65rem] uppercase tracking-[0.1em] text-white/50">
                Horarios flexibles: mañanas, tardes o fines de semana
              </span>
            </div>
          </div>
        </div>
      </div>

      {/* Practice Column */}
      <div class="how-classes-col group" data-reveal="fade" data-delay="2">
        <div class="relative h-full p-8 lg:p-10 rounded-3xl bg-[#CFA35A]/5 border border-[#CFA35A]/20 hover:border-[#CFA35A]/40 transition-all duration-500">
          {/* Header */}
          <div class="flex items-start gap-6 mb-10">
            <div class="w-16 h-16 rounded-2xl bg-[#CFA35A] flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform duration-500">
              <svg class="w-8 h-8 text-[#02060a]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M13 10V3L4 14h7v7l9-11h-7z"/>
              </svg>
            </div>
            <div>
              <span class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-[#CFA35A] block mb-2">En el mar</span>
              <h3 class="font-display font-black text-2xl lg:text-3xl uppercase tracking-tight text-white">
                Prácticas náuticas
              </h3>
            </div>
          </div>

          {/* Items */}
          <div class="space-y-6">
            {PRACTICE_ITEMS.map((item) => (
              <div class="flex gap-5 p-5 rounded-2xl bg-white/[0.03] border border-white/5 hover:border-[#CFA35A]/30 hover:bg-white/[0.05] transition-all duration-300 group/item">
                <div class="w-10 h-10 rounded-full bg-[#CFA35A]/20 flex items-center justify-center shrink-0 group-hover/item:bg-[#CFA35A] transition-colors">
                  <svg class="w-5 h-5 text-[#CFA35A] group-hover/item:text-[#02060a] transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d={item.icon}/>
                  </svg>
                </div>
                <div>
                  <h4 class="font-display font-bold text-white mb-1 group-hover/item:text-[#CFA35A] transition-colors">
                    {item.title}
                  </h4>
                  <p class="text-sm text-white/50 leading-relaxed">
                    {item.description}
                  </p>
                </div>
              </div>
            ))}
          </div>

          {/* Bottom Note */}
          <div class="mt-8 pt-6 border-t border-[#CFA35A]/20">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-full bg-[#CFA35A]/20 flex items-center justify-center">
                <svg class="w-4 h-4 text-[#CFA35A]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <span class="font-mono text-[0.65rem] uppercase tracking-[0.1em] text-white/50">
                Prácticas en Cádiz — Puerto Sherry o Puerto América
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("astro:page-load", () => {
    // Columns entrance animation
    gsap.fromTo(".how-classes-col", 
      { y: 50, opacity: 0 },
      {
        y: 0,
        opacity: 1,
        duration: 0.8,
        stagger: 0.15,
        ease: "power3.out",
        scrollTrigger: {
          trigger: "#how-classes",
          start: "top 70%",
        },
      }
    );
  });
</script>
