---
/**
 * TestimonialsSection — Testimonios de alumnos
 * Grid de 3 cards con reseñas reales de Google
 */
import { SectionLabel, SectionTitle } from "../ui";

const TESTIMONIALS = [
  {
    quote: "He hecho el curso de PER con él y lo he sacado del tirón. Manuel es un crack explicando y tiene una paciencia infinita.",
    author: "J.M.",
    role: "Alumno PER",
    rating: 5,
  },
  {
    quote: "Manuel es un instructor increíble y divertido. Las clases se pasan volando y aprendes mogollón. Totalmente recomendable.",
    author: "Antonio Lagarda",
    role: "Alumno Licencia",
    rating: 5,
  },
  {
    quote: "De las mejores experiencias de mi vida. No solo saqué el título, sino que descubrí una pasión que no sabía que tenía.",
    author: "Toniet Fornes",
    role: "Alumno PNB",
    rating: 5,
  },
  {
    quote: "El profesor, un 10/10. Explica muy bien, tiene mucha paciencia y te hace sentir seguro desde el primer momento.",
    author: "Diego Perea",
    role: "Alumno PER",
    rating: 5,
  },
  {
    quote: "Clases dinámicas, gran aprendizaje, buen rollo. Manuel sabe transmitir la pasión por la náutica de forma natural.",
    author: "Manuel Brenes",
    role: "Alumno Patrón Yate",
    rating: 5,
  },
] as const;

const STATS = [
  { value: "4.9", suffix: "/5", label: "Valoración" },
  { value: "500+", label: "Alumnos" },
  { value: "98%", label: "Aprueban" },
];
---

<section class="relative bg-[#FAFAFA] py-28 lg:py-36 overflow-hidden" id="testimonials-section" data-theme="light">
  {/* Background */}
  <div class="absolute inset-0 z-0">
    <div class="absolute top-0 right-0 w-[800px] h-[800px] bg-[#CFA35A]/[0.03] rounded-full blur-[150px]"></div>
    <div class="absolute bottom-0 left-0 w-[600px] h-[600px] bg-[#CFA35A]/[0.02] rounded-full blur-[120px]"></div>
  </div>

  <div class="container mx-auto px-6 lg:px-12 relative z-10 max-w-[1600px]">
    {/* Header */}
    <div class="testimonials-header flex flex-col lg:flex-row lg:items-end justify-between gap-10 mb-16 lg:mb-20">
      <div class="lg:w-1/2">
        <div class="mb-6">
          <SectionLabel label="Testimonios" variant="dark" />
        </div>
        <SectionTitle firstLine="Lo que dicen" secondLine="nuestros alumnos" />
      </div>

      {/* Stats */}
      <div class="flex gap-10 lg:pb-2">
        {STATS.map((stat) => (
          <div class="text-center group/stat cursor-default">
            <div class="flex items-baseline justify-center gap-1">
              <span class="font-display font-black text-3xl lg:text-4xl group-hover/stat:text-[#CFA35A] transition-colors duration-300">
                {stat.value}
              </span>
              {stat.suffix && (
                <span class="font-display text-lg text-[#CFA35A]">{stat.suffix}</span>
              )}
            </div>
            <span class="font-mono text-[0.6rem] uppercase tracking-[0.15em] text-[#0A0A0A]/40 group-hover/stat:text-[#0A0A0A]/70 transition-colors relative">
              {stat.label}
              <span class="absolute -bottom-1 left-1/2 -translate-x-1/2 w-0 h-[1px] bg-[#CFA35A] group-hover/stat:w-full transition-all duration-300" />
            </span>
          </div>
        ))}
      </div>
    </div>

    {/* Testimonials Grid */}
    <div class="testimonials-wrapper relative">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8" id="testimonials-grid">
        {TESTIMONIALS.slice(0, 3).map((testimonial, i) => (
          <div class="testimonial-card group relative" data-index={i}>
            <div class="relative h-full p-8 lg:p-10 rounded-[2rem] bg-white border border-[#0A0A0A]/5 hover:border-[#CFA35A]/20 transition-all duration-500 hover:shadow-[0_20px_60px_-15px_rgba(207,163,90,0.15)] hover:-translate-y-1">
              {/* Top accent line */}
              <div class="absolute top-0 left-10 right-10 h-[2px] bg-gradient-to-r from-transparent via-[#CFA35A] to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
              
              {/* Quote Icon */}
              <div class="absolute -top-4 -right-4 w-16 h-16 rounded-full bg-gradient-to-br from-[#CFA35A] to-[#8e6f38] flex items-center justify-center shadow-lg shadow-[#CFA35A]/20 group-hover:scale-110 group-hover:rotate-12 transition-all duration-300">
                <svg class="w-7 h-7 text-white" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
                </svg>
              </div>

              {/* Stars */}
              <div class="flex gap-1 mb-6">
                {Array(testimonial.rating).fill(null).map(() => (
                  <svg class="w-5 h-5 text-[#CFA35A]" viewBox="0 0 20 20" fill="currentColor">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                ))}
              </div>

              {/* Quote */}
              <blockquote class="font-body text-[#0A0A0A]/80 leading-relaxed mb-8 text-lg italic">
                "{testimonial.quote}"
              </blockquote>

              {/* Author */}
              <div class="flex items-center gap-4 pt-6 border-t border-[#0A0A0A]/5">
                <div class="w-14 h-14 rounded-full bg-gradient-to-br from-[#CFA35A] to-[#8e6f38] flex items-center justify-center shadow-lg group-hover:shadow-[0_0_20px_rgba(207,163,90,0.3)] transition-shadow">
                  <span class="font-display font-bold text-base text-white">
                    {testimonial.author.split(" ").map(n => n[0]).join("").substring(0, 2)}
                  </span>
                </div>
                <div class="flex-1">
                  <span class="font-display font-bold text-[#0A0A0A] block">{testimonial.author}</span>
                  <span class="font-mono text-[0.65rem] uppercase tracking-[0.15em] text-[#0A0A0A]/50">{testimonial.role}</span>
                </div>
                {/* Google Icon */}
                <div class="w-10 h-10 rounded-full bg-[#0A0A0A]/5 flex items-center justify-center">
                  <svg class="w-5 h-5 text-[#0A0A0A]/30" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                    <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                    <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                    <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                  </svg>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      {/* Navigation */}
      <div class="flex items-center justify-center gap-6 mt-12">
        <button
          class="test-nav-prev w-14 h-14 rounded-full border-2 border-[#0A0A0A]/10 flex items-center justify-center hover:border-[#CFA35A] hover:bg-[#CFA35A] hover:text-white transition-all duration-300 group"
          aria-label="Anterior"
        >
          <svg class="w-5 h-5 text-[#0A0A0A]/50 group-hover:text-white transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
        </button>

        {/* Dots */}
        <div class="flex items-center gap-3" id="testimonials-dots">
          <button class="test-dot w-3 h-3 rounded-full border-2 border-[#0A0A0A]/10 hover:border-[#CFA35A] transition-all duration-300 active" data-index="0" aria-label="Página 1"></button>
          <button class="test-dot w-3 h-3 rounded-full border-2 border-[#0A0A0A]/10 hover:border-[#CFA35A] transition-all duration-300" data-index="1" aria-label="Página 2"></button>
        </div>

        <button
          class="test-nav-next w-14 h-14 rounded-full border-2 border-[#0A0A0A]/10 flex items-center justify-center hover:border-[#CFA35A] hover:bg-[#CFA35A] hover:text-white transition-all duration-300 group"
          aria-label="Siguiente"
        >
          <svg class="w-5 h-5 text-[#0A0A0A]/50 group-hover:text-white transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </button>
      </div>
    </div>

    {/* Source Note */}
    <div class="mt-12 text-center">
      <p class="font-mono text-[0.65rem] uppercase tracking-[0.15em] text-[#0A0A0A]/40">
        Opiniones reales de Google Reviews · Filtradas solo de la academia
      </p>
    </div>
  </div>

  <style>
    .test-dot.active {
      background-color: #cfa35a;
      border-color: #cfa35a;
      transform: scale(1.2);
    }
  </style>

  <script define:vars={{ testimonials: TESTIMONIALS }}>
    // Client-side data and pagination logic
    const allTestimonials = testimonials;
    
    function renderTestimonialCard(t) {
      const initials = t.author
        .split(" ")
        .map((n) => n[0])
        .join("")
        .substring(0, 2);

      return `
        <div class="testimonial-card group relative">
          <div class="relative h-full p-8 lg:p-10 rounded-[2rem] bg-white border border-[#0A0A0A]/5 hover:border-[#CFA35A]/20 transition-all duration-500 hover:shadow-[0_20px_60px_-15px_rgba(207,163,90,0.15)] hover:-translate-y-1">
            <div class="absolute top-0 left-10 right-10 h-[2px] bg-gradient-to-r from-transparent via-[#CFA35A] to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            <div class="absolute -top-4 -right-4 w-16 h-16 rounded-full bg-gradient-to-br from-[#CFA35A] to-[#8e6f38] flex items-center justify-center shadow-lg shadow-[#CFA35A]/20 group-hover:scale-110 group-hover:rotate-12 transition-all duration-300">
              <svg class="w-7 h-7 text-white" viewBox="0 0 24 24" fill="currentColor">
                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
              </svg>
            </div>
            <div class="flex gap-1 mb-6">
              ${Array(t.rating).fill('<svg class="w-5 h-5 text-[#CFA35A]" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>').join('')}
            </div>
            <blockquote class="font-body text-[#0A0A0A]/80 leading-relaxed mb-8 text-lg italic">"${t.quote}"</blockquote>
            <div class="flex items-center gap-4 pt-6 border-t border-[#0A0A0A]/5">
              <div class="w-14 h-14 rounded-full bg-gradient-to-br from-[#CFA35A] to-[#8e6f38] flex items-center justify-center shadow-lg group-hover:shadow-[0_0_20px_rgba(207,163,90,0.3)] transition-shadow">
                <span class="font-display font-bold text-base text-white">${initials}</span>
              </div>
              <div class="flex-1">
                <span class="font-display font-bold text-[#0A0A0A] block">${t.author}</span>
                <span class="font-mono text-[0.65rem] uppercase tracking-[0.15em] text-[#0A0A0A]/50">${t.role}</span>
              </div>
              <div class="w-10 h-10 rounded-full bg-[#0A0A0A]/5 flex items-center justify-center">
                <svg class="w-5 h-5 text-[#0A0A0A]/30" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                  <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                  <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                  <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                </svg>
              </div>
            </div>
          </div>
        </div>
      `;
    }

    document.addEventListener("astro:page-load", () => {
      // GSAP animations
      if (typeof gsap !== "undefined") {
        gsap.registerPlugin(ScrollTrigger);

        // Header animation
        gsap.fromTo(
          ".testimonials-header",
          { y: 50, opacity: 0 },
          {
            y: 0,
            opacity: 1,
            duration: 1,
            ease: "power3.out",
            scrollTrigger: {
              trigger: "#testimonials-section",
              start: "top 80%",
            },
          }
        );

        // Cards animation
        gsap.fromTo(
          ".testimonial-card",
          { y: 60, opacity: 0 },
          {
            y: 0,
            opacity: 1,
            duration: 0.8,
            stagger: 0.15,
            ease: "power3.out",
            scrollTrigger: {
              trigger: ".testimonials-wrapper",
              start: "top 85%",
            },
          }
        );
      }

      // Pagination
      const grid = document.getElementById("testimonials-grid");
      const dots = document.querySelectorAll(".test-dot");
      const prevBtn = document.querySelector(".test-nav-prev");
      const nextBtn = document.querySelector(".test-nav-next");

      let currentPage = 0;
      const itemsPerPage = 3;
      const totalPages = Math.ceil(allTestimonials.length / itemsPerPage);

      function updateDots() {
        dots.forEach((dot, i) => {
          dot.classList.toggle("active", i === currentPage);
        });
      }

      function renderPage(page) {
        if (!grid) return;

        const start = page * itemsPerPage;
        const pageTestimonials = allTestimonials.slice(start, start + itemsPerPage);

        if (typeof gsap !== "undefined") {
          gsap.to(grid, {
            opacity: 0,
            y: 20,
            duration: 0.3,
            onComplete: () => {
              grid.innerHTML = pageTestimonials
                .map((t) => renderTestimonialCard(t))
                .join("");
              gsap.fromTo(grid, { opacity: 0, y: -20 }, { opacity: 1, y: 0, duration: 0.4 });
            },
          });
        } else {
          grid.innerHTML = pageTestimonials
            .map((t) => renderTestimonialCard(t))
            .join("");
        }

        updateDots();
      }

      dots.forEach((dot, i) => {
        dot.addEventListener("click", () => {
          currentPage = i;
          renderPage(currentPage);
        });
      });

      prevBtn?.addEventListener("click", () => {
        currentPage = currentPage > 0 ? currentPage - 1 : totalPages - 1;
        renderPage(currentPage);
      });

      nextBtn?.addEventListener("click", () => {
        currentPage = currentPage < totalPages - 1 ? currentPage + 1 : 0;
        renderPage(currentPage);
      });
    });
  </script>
</section>
