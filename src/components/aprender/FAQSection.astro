---
/**
 * FAQSection — Preguntas frecuentes
 * Accordion de 6 preguntas para resolver dudas
 */
import { SectionLabel, SectionTitle } from "../ui";

const FAQS = [
  {
    question: "¿Necesito experiencia previa para empezar?",
    answer: "No, para la Licencia de Navegación no necesitas ninguna experiencia previa. Es el título de iniciación perfecto. Para títulos superiores como el PER o Patrón de Yate, solo necesitas tener el título anterior o cumplir con los requisitos de edad establecidos.",
  },
  {
    question: "¿Cuánto tiempo duran los cursos?",
    answer: "Depende del título. La Licencia de Navegación solo requiere 4 horas de prácticas. El PNB necesita aprobar el teórico y hacer 8 horas de prácticas. El PER requiere 16 horas de navegación y 12 de radiocomunicaciones. El PER ampliado necesita una travesía de 24 horas. Cada alumno marca su ritmo para preparar el teórico.",
  },
  {
    question: "¿El precio incluye el examen oficial?",
    answer: "Los precios indicados incluyen la formación teórica (si la imparte la academia) y las prácticas obligatorias. El examen oficial tiene un coste aparte que se paga directamente a la capitanía marítima en el momento de la inscripción. Te ayudamos con todo el papeleo.",
  },
  {
    question: "¿Se puede compaginar con trabajo?",
    answer: "Totalmente. Ofrecemos horarios flexibles: clases teóricas en fines de semana o tardes, y prácticas que se pueden concertar según tu disponibilidad. Muchos alumnos sacan su título combinándolo con su trabajo habitual.",
  },
  {
    question: "¿Dónde se realizan las prácticas?",
    answer: "Las prácticas se realizan en la bahía de Cádiz, normalmente desde Puerto Sherry (El Puerto de Santa María) o Puerto América (Rota). Es una zona ideal para aprender: aguas protegidas, buenas condiciones y variedad de escenarios de navegación.",
  },
  {
    question: "¿Qué pasa si no apruebo el examen a la primera?",
    answer: "No te preocupes, muchos alumnos necesitan más de un intento. Puedes volver a presentarte en la siguiente convocatoria. Si necesitas refuerzo en alguna materia, ofrecemos clases de recuperación específicas para preparar mejor el siguiente examen.",
  },
] as const;
---

<section class="relative bg-[#02060a] py-28 lg:py-36 overflow-hidden" id="faq-section" data-theme="dark">
  {/* Background Effects */}
  <div class="absolute inset-0 z-0">
    <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-[#CFA35A]/30 to-transparent"></div>
    <div class="absolute bottom-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-[#CFA35A]/30 to-transparent"></div>
    <div class="absolute top-1/3 right-0 w-[500px] h-[500px] bg-[#CFA35A]/[0.02] rounded-full blur-[150px]"></div>
  </div>

  <div class="container mx-auto px-6 lg:px-12 relative z-10 max-w-[1000px]">
    {/* Header */}
    <div class="text-center max-w-2xl mx-auto mb-16 lg:mb-20">
      <div class="mb-6 flex justify-center">
        <SectionLabel label="Preguntas frecuentes" variant="light" />
      </div>
      <SectionTitle firstLine="Resolvemos tus" secondLine="dudas" />
      <p class="font-body text-base lg:text-lg text-white/60 leading-relaxed mt-6">
        Todo lo que necesitas saber antes de empezar tu formación náutica. 
        ¿Tienes más preguntas? Contáctanos directamente.
      </p>
    </div>

    {/* FAQ Accordion */}
    <div class="space-y-4" id="faq-accordion">
      {FAQS.map((faq, i) => (
        <div 
          class="faq-item group relative overflow-hidden rounded-2xl border border-white/10 bg-white/[0.02] hover:border-[#CFA35A]/20 transition-all duration-500"
          data-faq-index={i}
          data-reveal="fade"
          data-delay={i + 1}
        >
          {/* Question Button */}
          <button 
            class="faq-trigger w-full p-6 lg:p-8 flex items-start gap-6 text-left transition-all duration-300"
            aria-expanded="false"
            aria-controls={`faq-answer-${i}`}
          >
            {/* Number */}
            <div class="hidden sm:flex w-10 h-10 rounded-full bg-[#CFA35A]/10 border border-[#CFA35A]/20 items-center justify-center shrink-0 group-hover:bg-[#CFA35A] group-hover:border-[#CFA35A] transition-all duration-300">
              <span class="font-display font-bold text-sm text-[#CFA35A] group-hover:text-[#02060a] transition-colors">
                0{i + 1}
              </span>
            </div>

            {/* Question */}
            <div class="flex-1">
              <h3 class="font-display font-bold text-lg lg:text-xl text-white group-hover:text-[#CFA35A] transition-colors pr-12">
                {faq.question}
              </h3>
            </div>

            {/* Expand Icon */}
            <div class="absolute right-6 top-6 w-10 h-10 rounded-full border border-white/10 flex items-center justify-center group-hover:border-[#CFA35A]/50 group-hover:bg-[#CFA35A]/10 transition-all duration-300">
              <svg 
                class="faq-icon w-5 h-5 text-white/50 group-hover:text-[#CFA35A] transition-all duration-300" 
                viewBox="0 0 24 24" 
                fill="none" 
                stroke="currentColor" 
                stroke-width="2"
              >
                <path d="M12 5v14M5 12h14"/>
              </svg>
            </div>
          </button>

          {/* Answer */}
          <div 
            id={`faq-answer-${i}`}
            class="faq-answer hidden px-6 lg:px-8 pb-8 lg:pl-[88px]"
          >
            <div class="pt-2 border-t border-white/10">
              <p class="text-white/70 leading-relaxed">
                {faq.answer}
              </p>
            </div>
          </div>
        </div>
      ))}
    </div>

    {/* CTA Box */}
    <div class="mt-16 lg:mt-20">
      <div class="relative bg-[#CFA35A]/10 rounded-3xl p-8 lg:p-12 border border-[#CFA35A]/20 overflow-hidden">
        {/* Background glow */}
        <div class="absolute top-0 right-0 w-[300px] h-[300px] bg-[#CFA35A]/10 rounded-full blur-[100px]"></div>
        
        <div class="relative z-10 flex flex-col lg:flex-row items-center justify-between gap-8">
          <div class="text-center lg:text-left">
            <h3 class="font-display font-black text-2xl lg:text-3xl uppercase text-white mb-2">
              ¿Tienes más <span class="text-[#CFA35A]">preguntas?</span>
            </h3>
            <p class="text-white/50 text-sm lg:text-base">
              Manuel te atiende directamente por teléfono o WhatsApp
            </p>
          </div>
          
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="tel:+34605183785" class="group inline-flex items-center justify-center gap-3 px-8 py-4 bg-[#CFA35A] text-[#02060a] rounded-full font-display font-bold text-sm uppercase tracking-wider hover:bg-white transition-all duration-300">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/>
              </svg>
              <span>Llamar</span>
            </a>
            
            <a href="https://wa.me/34605183785" target="_blank" rel="noopener noreferrer" class="group inline-flex items-center justify-center gap-3 px-8 py-4 border border-white/20 text-white rounded-full font-display font-bold text-sm uppercase tracking-wider hover:bg-white/10 hover:border-[#CFA35A] transition-all duration-300">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              <span>WhatsApp</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Active state for expanded items */
  .faq-item.active {
    border-color: rgba(207, 163, 90, 0.3);
    background: rgba(255, 255, 255, 0.04);
  }
  
  .faq-item.active .faq-icon {
    transform: rotate(45deg);
    color: #CFA35A;
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const triggers = document.querySelectorAll(".faq-trigger");
    
    triggers.forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const item = trigger.closest(".faq-item");
        const answer = item?.querySelector(".faq-answer");
        const isExpanded = trigger.getAttribute("aria-expanded") === "true";
        
        // Close all other items
        document.querySelectorAll(".faq-item").forEach((otherItem) => {
          if (otherItem !== item) {
            otherItem.classList.remove("active");
            const otherTrigger = otherItem.querySelector(".faq-trigger");
            const otherAnswer = otherItem.querySelector(".faq-answer");
            otherTrigger?.setAttribute("aria-expanded", "false");
            otherAnswer?.classList.add("hidden");
          }
        });
        
        // Toggle current item
        if (isExpanded) {
          item?.classList.remove("active");
          trigger.setAttribute("aria-expanded", "false");
          answer?.classList.add("hidden");
        } else {
          item?.classList.add("active");
          trigger.setAttribute("aria-expanded", "true");
          answer?.classList.remove("hidden");
          
          // Animate content in
          if (answer && typeof gsap !== "undefined") {
            gsap.fromTo(answer, 
              { opacity: 0, y: -10 },
              { opacity: 1, y: 0, duration: 0.3, ease: "power2.out" }
            );
          }
        }
      });
    });
  });
</script>
