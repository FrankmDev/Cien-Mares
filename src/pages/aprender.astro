---
/**
 * Cien Mares — Academia Náutica
 * 
 * Página de formación náutica con:
 * - Hero cinematográfico
 * - Tabla expandible de títulos
 * - Cards de perfeccionamiento
 * - Sección de metodología (teoría/práctica)
 * - Testimonios de alumnos
 * - Preguntas frecuentes
 * - CTA Banner final
 */

import Layout from '@/layouts/Layout.astro';
import {
  HeroSection,
  TitlesSection,
  PerfectionSection,
  HowClassesWorkSection,
  TestimonialsSection,
  FAQSection,
  CTABanner,
} from '@/components/aprender';
import { pageMetadata } from '@/data/site';

// ═══════════════════════════════════════════════════════════════════════════════
// PAGE METADATA - Centralized in src/data/site.ts
// ═══════════════════════════════════════════════════════════════════════════════

const meta = pageMetadata.aprender;
---

<Layout
  title={meta.title}
  description={meta.description}
  image={meta.image}
>
  {/* Hero Section — Pantalla completa con imagen de prácticas */}
  <HeroSection />

  {/* Títulos Disponibles — Tabla expandible con 7 títulos */}
  <TitlesSection />

  {/* Clases de Perfeccionamiento — 2 cards: vela y motor */}
  <PerfectionSection />

  {/* Cómo son las clases — 2 columnas: teoría y práctica */}
  <HowClassesWorkSection />

  {/* Testimonios de alumnos — Grid de 3 cards con reseñas */}
  <TestimonialsSection />

  {/* Preguntas frecuentes — Accordion de 6 preguntas */}
  <FAQSection />

  {/* CTA Banner — Orientación sin compromiso */}
  <CTABanner />
</Layout>
