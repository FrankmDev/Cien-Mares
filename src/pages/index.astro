---
/**
 * Cien Mares - Homepage
 * 
 * Arquitectura: Component-based sections con:
 * - TypeScript stricto
 * - Scripts GSAP extraídos a archivos dedicados
 * - Componentes UI atómicos reutilizables
 * - Constantes compartidas (colores, easing, etc.)
 * - Cleanup apropiado de animaciones
 */

import Layout from '@/layouts/Layout.astro';
import {
	HeroSection,
	StorySection,
	ServicesSection,
	MethodologySection,
	TestimonialsSection,
	CTASection,
} from '@/components/home';
import { pageMetadata } from '@/data/site';

// ═══════════════════════════════════════════════════════════════════════════════
// PAGE METADATA - Centralized in src/data/site.ts
// ═══════════════════════════════════════════════════════════════════════════════

const meta = pageMetadata.home;
---

<Layout
	title={meta.title}
	description={meta.description}
	image={meta.image}
	transparentHeader={true}
>
	<main class="home">
		<HeroSection />
		<StorySection />
		<ServicesSection />
		<MethodologySection />
		<TestimonialsSection />
		<CTASection />
	</main>
</Layout>

<style>
	.home {
		position: relative;
		overflow-x: hidden;
		background-color: #050505;
	}
</style>
