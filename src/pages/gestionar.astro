---
/**
 * Cien Mares — Gestión Náutica
 * 
 * Página de gestoría y traslados con:
 * - Hero cinematográfico
 * - Grid de servicios de gestoría con precios
 * - 3 bloques de qué incluye la gestión
 * - Sección de traslados (nacional e internacional)
 * - Proceso de contratación en 3 pasos
 * - CTA Banner final
 */

import Layout from '@/layouts/Layout.astro';
import {
  HeroSection,
  GestoriaSection,
  IncluyeSection,
  TrasladosSection,
  ProcesoSection,
  CTABanner,
} from '@/components/gestionar';

// ═══════════════════════════════════════════════════════════════════════════════
// PAGE METADATA
// ═══════════════════════════════════════════════════════════════════════════════

const pageMeta = {
  title: "Gestión Náutica | Gestoría y Traslados | Cien Mares",
  description:
    "Gestoría náutica completa: inscripciones, certificados, cambios de titularidad. Traslados de embarcaciones nacionales e internacionales. Precios transparentes y servicio profesional.",
};
---

<Layout
  title={pageMeta.title}
  description={pageMeta.description}
>
  {/* Hero Section — Pantalla completa con imagen de yate */}
  <HeroSection />

  {/* Gestoría Section — Grid de servicios con precios */}
  <GestoriaSection />

  {/* Incluye Section — 3 bloques de características */}
  <IncluyeSection />

  {/* Traslados Section — Nacional e internacional */}
  <TrasladosSection />

  {/* Proceso Section — 3 pasos de contratación */}
  <ProcesoSection />

  {/* CTA Banner — Respuesta en 24h */}
  <CTABanner />
</Layout>
