---
/**
 * Cien Mares — Contacto
 * 
 * Página de contacto con:
 * - Hero cinematográfico
 * - Información de contacto (teléfono, email, ubicación, horarios)
 * - Formulario de contacto funcional
 * - Mapa y ubicación
 * - CTA WhatsApp
 */

import Layout from '@/layouts/Layout.astro';
import {
  HeroSection,
  InfoSection,
  FormSection,
  MapSection,
  CTABanner,
} from '@/components/contacto';

// ═══════════════════════════════════════════════════════════════════════════════
// PAGE METADATA
// ═══════════════════════════════════════════════════════════════════════════════

const pageMeta = {
  title: "Contacto | Cien Mares | Servicios Náuticos en Cádiz",
  description:
    "Contacta con Cien Mares. Teléfono: +34 605 18 37 85. Email: info@cienmares.es. WhatsApp disponible. Estamos en El Puerto de Santa María, Cádiz.",
};
---

<Layout
  title={pageMeta.title}
  description={pageMeta.description}
>
  {/* Hero Section — Pantalla completa con imagen cinematográfica */}
  <HeroSection />

  {/* Info Section — Grid de información de contacto */}
  <InfoSection />

  {/* Form Section — Formulario de contacto funcional */}
  <FormSection />

  {/* Map Section — Ubicación y mapa */}
  <MapSection />

  {/* CTA Banner — WhatsApp directo */}
  <CTABanner />
</Layout>
