---
/**
 * Cien Mares — Contacto
 * 
 * Página de contacto con:
 * - Hero cinematográfico
 * - Información de contacto (teléfono, email, ubicación, horarios)
 * - Formulario de contacto funcional
 * - Mapa y ubicación
 * - CTA WhatsApp
 */

import Layout from '@/layouts/Layout.astro';
import {
  HeroSection,
  InfoSection,
  FormSection,
  MapSection,
  CTABanner,
} from '@/components/contacto';
import { pageMetadata } from '@/data/site';

// ═══════════════════════════════════════════════════════════════════════════════
// PAGE METADATA - Centralized in src/data/site.ts
// ═══════════════════════════════════════════════════════════════════════════════

const meta = pageMetadata.contacto;
---

<Layout
  title={meta.title}
  description={meta.description}
  image={meta.image}
>
  {/* Hero Section — Pantalla completa con imagen cinematográfica */}
  <HeroSection />

  {/* Info Section — Grid de información de contacto */}
  <InfoSection />

  {/* Form Section — Formulario de contacto funcional */}
  <FormSection />

  {/* Map Section — Ubicación y mapa */}
  <MapSection />

  {/* CTA Banner — WhatsApp directo */}
  <CTABanner />
</Layout>
